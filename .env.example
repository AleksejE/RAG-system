# ----- LLM (Groq), нужен только модулю RAG -----
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3

# ----- Эмбеддинги -----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# ----- Векторная база Qdrant -----
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=constitution_rf
# Локальный режим без Docker: база хранится в этой папке, QDRANT_URL игнорируется
# QDRANT_PATH=qdrant_local

# ----- Источник данных -----
SOURCE_URL=https://constitution.garant.ru/english/

# ----- Параметры RAG -----
CHUNK_SIZE=600
CHUNK_OVERLAP=100
PAGE_SIZE_CHARS=1500
TOP_K_RESULTS=5
